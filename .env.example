# Public env vars — exposed to the browser. Safe to commit.
# Configure these in your Vercel project settings under "Environment Variables".

# Supabase project URL (e.g. https://abcdefghij.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key (publishable, safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe publishable key (safe for the browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe price IDs (created in the Stripe dashboard, matching the
# Edge Function's create-checkout-session mapping).
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=

# Chrome extension ID. Used to ping the extension after a successful
# Stripe checkout so the entitlement cache refreshes. Format:
# abcdefghijklmnopqrstuvwxyzabcdef
NEXT_PUBLIC_EXTENSION_ID=

# Public canonical URL for OG/Twitter metadata. Defaults to
# https://video-subtitle-translator.vercel.app if unset.
NEXT_PUBLIC_SITE_URL=

# Comma-separated OAuth provider names enabled in the Supabase project.
# If unset, defaults to "google" so the social-login button is shown.
# Set to "" (empty) to hide the social button until you've configured
# the providers in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_OAUTH_PROVIDERS=
